<?xml version="1.0" encoding="utf-8"?>
<BuildingMaterials xmlns="Ambient.Domain"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\..\..\..\bin\net8.0-windows7.0\Content\Schemas\Gameplay\Gameplay.xsd">

    <!-- ========================================
         BUILDING MATERIALS
         Adhesives and fasteners for construction
         ======================================== -->

    <!-- BASIC MATERIALS - What travelers start with -->
    <BuildingMaterial RefName="Nails" DisplayName="Nails" Description="Nails for basic wood construction" TextureRef="Nails" WholesalePrice="2" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Wood"/>
            <Substance SubstanceRef="Plant"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Mortar" DisplayName="Mortar" Description="Stone mortar for construction" TextureRef="Mortar" WholesalePrice="3" Rarity="Common">
        <CompatibleSubstances>
            <Substance SubstanceRef="Stone"/>
            <Substance SubstanceRef="Aggregate"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Clay" DisplayName="Clay" Description="Natural clay binding material" TextureRef="Mortar" WholesalePrice="2" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Aggregate"/>
            <Substance SubstanceRef="Stone"/>
            <Substance SubstanceRef="Carbon"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <!-- ADVANCED MATERIALS - Available from TradingPost merchant -->
    <BuildingMaterial RefName="WoodGlue" DisplayName="Wood Glue" Description="Strong adhesive for joining wooden components" TextureRef="WoodGlue" WholesalePrice="4" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Wood"/>
            <Substance SubstanceRef="Plant"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Cement" DisplayName="Cement" Description="Hydraulic cement for concrete construction" TextureRef="Cement" WholesalePrice="5" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Stone"/>
            <Substance SubstanceRef="Aggregate"/>
            <Substance SubstanceRef="SteelReinforcedConcrete"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Screws" DisplayName="Metal Screws" Description="Steel fasteners for metal construction" TextureRef="Screws" WholesalePrice="3" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Steel"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Bolts" DisplayName="Bolts" Description="Threaded fasteners for metal and heavy construction" TextureRef="Bolts" WholesalePrice="4" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Metal"/>
            <Substance SubstanceRef="Steel"/>
            <Substance SubstanceRef="Wood"/>
        </CompatibleSubstances>
    </BuildingMaterial>

    <BuildingMaterial RefName="Epoxy" DisplayName="Epoxy Resin" Description="Strong adhesive for multiple materials" TextureRef="Epoxy" WholesalePrice="12" Rarity="Uncommon">
        <CompatibleSubstances>
            <Substance SubstanceRef="Wood"/>
            <Substance SubstanceRef="Metal"/>
            <Substance SubstanceRef="Stone"/>
            <Substance SubstanceRef="Plant"/>
        </CompatibleSubstances>
    </BuildingMaterial>
    
</BuildingMaterials>

<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\Schemas\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_ISE" DisplayName="Defender of Ise" Description="Stand as the ultimate protector of Ise by finishing the main storyline.">
    <Criteria Type="SagaArcsCompleted" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_ISE" DisplayName="Vanquisher" Description="Strike down every powerful foe who dares challenge you in Ise.">
    <Criteria Type="CharactersDefeatedByType" CharacterType="Boss" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_ISE" DisplayName="Explorer" Description="Leave no corner of Ise undiscovered in your quest for knowledge.">
    <Criteria Type="SagaArcsDiscovered" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_ISE" DisplayName="Networker" Description="Build connections with everyone you meet throughout Ise.">
    <Criteria Type="UniqueCharactersMet" Threshold="17" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_ISE" DisplayName="Master Conversationalist" Description="Exhaust every dialogue option with the people of Ise.">
    <Criteria Type="DialogueTreesCompleted" Threshold="17" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_ISE" DisplayName="Perfectionist" Description="Leave no token unclaimed in your journey through Ise.">
    <Criteria Type="QuestTokensEarned" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_ISE" DisplayName="Bargain Hunter" Description="Seek out every merchant and their wares in Ise.">
    <Criteria Type="ItemsTraded" Threshold="10" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_ISE" DisplayName="Ambassador" Description="Represent the best of humanity in your dealings throughout Ise.">
    <Criteria Type="TraitsAssignedByType" TraitType="Friendly" Threshold="8" />
  </Achievement>
</Achievements>
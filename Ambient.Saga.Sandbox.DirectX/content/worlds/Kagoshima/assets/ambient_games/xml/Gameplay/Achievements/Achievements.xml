<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\Schemas\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_KAGOSHIMA" DisplayName="Legend of Kagoshima" Description="Write your name in the annals of Kagoshima's history by completing the main quest.">
    <Criteria Type="SagaArcsCompleted" Threshold="3" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_KAGOSHIMA" DisplayName="Slayer" Description="Bring low every mighty enemy that terrorizes the lands of Kagoshima.">
    <Criteria Type="CharactersDefeatedByType" CharacterType="Boss" Threshold="2" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_KAGOSHIMA" DisplayName="Trailblazer" Description="Be the first to set foot in all the locations of Kagoshima.">
    <Criteria Type="SagaArcsDiscovered" Threshold="3" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_KAGOSHIMA" DisplayName="Charmer" Description="Win the attention of every character in Kagoshima.">
    <Criteria Type="UniqueCharactersMet" Threshold="102" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_KAGOSHIMA" DisplayName="Eloquent" Description="Leave no word unspoken in your travels through Kagoshima.">
    <Criteria Type="DialogueTreesCompleted" Threshold="102" />
  </Achievement>

        </Objectives>
      </Stage>
      <Stage RefName="find_thief" DisplayName="Track Down the Thief" NextStage="resolve">
        <Objectives>
          <Objective RefName="identify_thief" Type="QuestTokenCollected" Threshold="1" DisplayName="Identify the thief" QuestTokenRef="MissingHeirloom_ThiefIdentified" />

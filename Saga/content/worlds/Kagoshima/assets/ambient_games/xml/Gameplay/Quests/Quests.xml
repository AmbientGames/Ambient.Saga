      <Stage RefName="investigate" DisplayName="Investigate the Theft" NextStage="find_thief">
        <Objectives LogicalOperator="OR">
          <Objective RefName="gather_witness" Type="QuestTokenCollected" Threshold="1" DisplayName="Get a witness statement" QuestTokenRef="MissingHeirloom_Evidence_WitnessAccount" />
          <Objective RefName="gather_footprints" Type="QuestTokenCollected" Threshold="1" DisplayName="Find physical evidence" QuestTokenRef="MissingHeirloom_Evidence_Footprints" />

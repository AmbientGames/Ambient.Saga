    <Rewards>
      <Reward Condition="OnSuccess">
        <Currency Amount="200" />
      </Reward>
      <Reward Condition="OnSuccess">
        <Experience Amount="100" />
      </Reward>
      <Reward Condition="OnSuccess">
        <Achievement AchievementRef="BANDIT_SLAYER" />
      </Reward>
    </Rewards>
  </Quest>

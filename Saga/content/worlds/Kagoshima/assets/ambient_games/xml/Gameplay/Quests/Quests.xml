    <Stages StartStage="clear_scouts">
      <Stage RefName="clear_scouts" DisplayName="Clear the Roads" NextStage="assault">
        <Objectives>
          <Objective RefName="defeat_scouts" Type="CharacterDefeated" Threshold="1" DisplayName="Defeat the bandit scout on the roads" CharacterRef="BanditChief_Scout" />
        </Objectives>
        <Rewards>
          <Reward Condition="OnSuccess">
            <Experience Amount="20" />
          </Reward>
        </Rewards>
      </Stage>
      <Stage RefName="assault" DisplayName="Assault the Hideout" NextStage="boss">
        <Objectives>
          <Objective RefName="defeat_enforcers" Type="CharacterDefeated" Threshold="1" DisplayName="Defeat the bandit enforcer" CharacterRef="BanditChief_Enforcer" />
          <Objective RefName="rescue_prisoner" Type="DialogueCompleted" Threshold="1" DisplayName="Rescue the captured merchant" DialogueRef="BanditChief_PrisonerRescue" Optional="true" />
        </Objectives>

        <Experience Amount="100" />
      </Reward>
      <Reward Condition="OnBranch" BranchRef="redeem">
        <Experience Amount="50" />
      </Reward>
    </Rewards>
  </Quest>
  <Quest RefName="HiddenCache_Quest" DisplayName="The Buried Treasure" Description="Follow ancient clues to discover a hidden cache of treasure.">

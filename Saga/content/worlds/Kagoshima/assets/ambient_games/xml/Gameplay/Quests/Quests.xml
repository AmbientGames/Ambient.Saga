          </Reward>
        </Rewards>
      </Stage>
      <Stage RefName="boss" DisplayName="Defeat the Chief" NextStage="report">
        <Objectives>
          <Objective RefName="defeat_chief" Type="CharacterDefeated" Threshold="1" DisplayName="Defeat the Bandit Chief" CharacterRef="BanditChief_Boss" />
        </Objectives>
        <Rewards>
          <Reward Condition="OnSuccess">

      <Stage RefName="report" DisplayName="Claim Your Reward">
        <Objectives>
          <Objective RefName="turn_in" Type="DialogueNodeVisited" Threshold="1" DisplayName="Report your victory" DialogueRef="BanditChief_QuestStart" NodeRef="reward_complete" />
        </Objectives>
      </Stage>

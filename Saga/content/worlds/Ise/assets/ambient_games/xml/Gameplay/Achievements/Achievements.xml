<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\xsd\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_ISE" DisplayName="Champion of Ise" Description="See the main quest through to its triumphant conclusion in Ise.">
    <Criteria Type="ArcsCompleted" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_ISE" DisplayName="Slayer" Description="Bring low every mighty enemy that terrorizes the lands of Ise.">
    <Criteria Type="CharactersDefeatedByTrait" Trait="BossFight" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_ISE" DisplayName="Cartographer" Description="Map every location and landmark throughout Ise.">
    <Criteria Type="ArcsDiscovered" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_ISE" DisplayName="People Person" Description="Introduce yourself to all the characters you encounter in Ise.">
    <Criteria Type="UniqueCharactersMet" Threshold="17" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_ISE" DisplayName="Wordsmith" Description="Master the art of conversation with everyone in Ise.">
    <Criteria Type="DialogueTreesCompleted" Threshold="17" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_ISE" DisplayName="Perfectionist" Description="Leave no token unclaimed in your journey through Ise.">
    <Criteria Type="QuestTokensEarned" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_ISE" DisplayName="Master Trader" Description="Conduct business with every merchant in Ise.">
    <Criteria Type="ItemsTraded" Threshold="10" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_ISE" DisplayName="Ambassador" Description="Represent the best of humanity in your dealings throughout Ise.">
    <Criteria Type="TraitsAssignedByType" Trait="Friendly" Threshold="8" />
  </Achievement>
  <Achievement RefName="BANDIT_SLAYER" DisplayName="Bandit Slayer" Description="Defeat the Bandit Chief and make the roads safe again.">
    <Criteria Type="CharactersDefeatedByRef" Threshold="1" CharacterRef="BanditChief_Boss" />
  </Achievement>
  <Achievement RefName="TREASUREHUNTER" DisplayName="Treasure Hunter" Description="Follow the faded map to its end and claim the hidden cache.">
    <Criteria Type="QuestsCompletedByRef" Threshold="1" QuestRef="HiddenCache_Quest" />
  </Achievement>
  <Achievement RefName="MASTERSTUDENT" DisplayName="Master's Student" Description="Pass the three trials and learn the Lost Technique from its last master.">
    <Criteria Type="QuestsCompletedByRef" Threshold="1" QuestRef="LostTechnique_Quest" />
  </Achievement>
</Achievements>

<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ../../../../../../../xsd/Gameplay/Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="BANDIT_SLAYER" DisplayName="Bandit Slayer" Description="Defeat the Bandit Chief and make the roads safe again.">
    <Criteria Type="CharactersDefeatedByRef" Threshold="1" CharacterRef="BanditChief_Boss" />
  </Achievement>
  <Achievement RefName="TREASUREHUNTER" DisplayName="Treasure Hunter" Description="Follow the faded map to its end and claim the hidden cache.">
    <Criteria Type="QuestsCompletedByRef" Threshold="1" QuestRef="HiddenCache_Quest" />
  </Achievement>
  <Achievement RefName="MASTERSTUDENT" DisplayName="Master's Student" Description="Pass the three trials and learn the Lost Technique from its last master.">
    <Criteria Type="QuestsCompletedByRef" Threshold="1" QuestRef="LostTechnique_Quest" />
  </Achievement>
  <Achievement RefName="WanderingMerchant_Patron" DisplayName="Patron of the Road" Description="Earn the wandering merchant's lasting goodwill and keep the trade roads safe.">
    <Criteria Type="CharactersDefeatedByRef" Threshold="1" CharacterRef="WanderingMerchant_Bandit" />
  </Achievement>
  <Achievement RefName="ACH_COMPLETE_ISE" DisplayName="Savior of Ise" Description="Fulfill your destiny and bring peace to the lands of Ise.">
    <Criteria Type="QuestsCompletedByRef" QuestRef="MAIN_QUEST_02" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_ISE" DisplayName="Vanquisher" Description="Strike down every powerful foe who dares challenge you in Ise.">
    <Criteria Type="CharactersDefeatedByTrait" Trait="BossFight" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_ISE" DisplayName="Wanderer" Description="Let your curiosity guide you to every hidden place in Ise.">
    <Criteria Type="ArcsDiscovered" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_ISE" DisplayName="Charmer" Description="Win the attention of every character in Ise.">
    <Criteria Type="UniqueCharactersMet" Threshold="10" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_ISE" DisplayName="Master Conversationalist" Description="Exhaust every dialogue option with the people of Ise.">
    <Criteria Type="DialogueTreesCompleted" Threshold="10" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_ISE" DisplayName="Trophy Hunter" Description="Claim every token as proof of your exploits in Ise.">
    <Criteria Type="QuestTokensEarned" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_ISE" DisplayName="Peacemaker" Description="Spread goodwill wherever you travel in Ise.">
    <Criteria Type="TraitsAssignedByType" Trait="Friendly" Threshold="8" />
  </Achievement>
  <Achievement RefName="ACH_FIRST_BLOOD_ISE" DisplayName="First Blood" Description="Win your first battle in Ise.">
    <Criteria Type="CharactersDefeated" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_ATTENTIVE_ISE" DisplayName="Attentive Listener" Description="Hear out the people of Ise.">
    <Criteria Type="DialogueNodesVisited" Threshold="5" />
  </Achievement>
  <Achievement RefName="ACH_QUEST_DONE_ISE" DisplayName="Task Completed" Description="Complete a quest in Ise.">
    <Criteria Type="QuestsCompleted" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_TRIGGERS_ISE" DisplayName="Chain Reaction" Description="Set a story event in motion in Ise.">
    <Criteria Type="ArcTriggersActivated" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_IMPRESSION_ISE" DisplayName="Lasting Impression" Description="Change how someone in Ise regards you.">
    <Criteria Type="TraitsAssigned" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_FRIEND_ISE" DisplayName="Fast Friends" Description="Win over a merchant in Ise.">
    <Criteria Type="TraitsAssignedToCharacterType" CharacterType="Merchant" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_RESPECTED_ISE" DisplayName="Respected" Description="Reach Friendly standing with any faction of Ise.">
    <Criteria Type="FactionsAtReputationLevel" ReputationLevel="Friendly" Threshold="1" />
  </Achievement>
  <Achievement RefName="ACH_ALLIED_ISE" DisplayName="Trusted Ally" Description="Earn Friendly standing with the School Security of Ise.">
    <Criteria Type="ReputationReached" FactionRef="CityGuard" ReputationLevel="Friendly" Threshold="1" />
  </Achievement>
</Achievements>
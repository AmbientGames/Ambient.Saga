<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\Schemas\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_KAGOSHIMA" DisplayName="Legend of Kagoshima" Description="Write your name in the annals of Kagoshima's history by completing the main quest.">
    <Criteria Type="SagaArcsCompleted" Threshold="3" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_KAGOSHIMA" DisplayName="Champion" Description="Prove your combat mastery by defeating all the bosses in Kagoshima.">
    <Criteria Type="CharactersDefeatedByType" CharacterType="Boss" Threshold="3" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_KAGOSHIMA" DisplayName="Explorer" Description="Leave no corner of Kagoshima undiscovered in your quest for knowledge.">
    <Criteria Type="SagaArcsDiscovered" Threshold="3" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_KAGOSHIMA" DisplayName="Networker" Description="Build connections with everyone you meet throughout Kagoshima.">
    <Criteria Type="UniqueCharactersMet" Threshold="75" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_KAGOSHIMA" DisplayName="Story Seeker" Description="Listen to every tale the inhabitants of Kagoshima have to tell.">
    <Criteria Type="DialogueTreesCompleted" Threshold="75" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_KAGOSHIMA" DisplayName="Completionist" Description="Collect every quest token available in Kagoshima.">
    <Criteria Type="QuestTokensEarned" Threshold="19" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_KAGOSHIMA" DisplayName="Patron" Description="Support the commerce of Kagoshima by trading with every vendor.">
    <Criteria Type="ItemsTraded" Threshold="115" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_KAGOSHIMA" DisplayName="Beloved" Description="Become cherished by the inhabitants of Kagoshima.">
    <Criteria Type="TraitsAssignedByType" TraitType="Friendly" Threshold="37" />
  </Achievement>
</Achievements>
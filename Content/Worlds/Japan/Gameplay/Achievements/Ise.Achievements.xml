<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\Schemas\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_ISE" DisplayName="Legend of Ise" Description="Write your name in the annals of Ise's history by completing the main quest.">
    <Criteria Type="SagaArcsCompleted" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_ISE" DisplayName="Champion" Description="Prove your combat mastery by defeating all the bosses in Ise.">
    <Criteria Type="CharactersDefeatedByType" CharacterType="Boss" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_ISE" DisplayName="Trailblazer" Description="Be the first to set foot in all the locations of Ise.">
    <Criteria Type="SagaArcsDiscovered" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_ISE" DisplayName="Charmer" Description="Win the attention of every character in Ise.">
    <Criteria Type="UniqueCharactersMet" Threshold="16" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_ISE" DisplayName="Wordsmith" Description="Master the art of conversation with everyone in Ise.">
    <Criteria Type="DialogueTreesCompleted" Threshold="16" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_ISE" DisplayName="Completionist" Description="Collect every quest token available in Ise.">
    <Criteria Type="QuestTokensEarned" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_ISE" DisplayName="Master Trader" Description="Conduct business with every merchant in Ise.">
    <Criteria Type="ItemsTraded" Threshold="5" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_ISE" DisplayName="Diplomat" Description="Forge friendships with the people of Ise through kindness.">
    <Criteria Type="TraitsAssignedByType" TraitType="Friendly" Threshold="8" />
  </Achievement>
</Achievements>
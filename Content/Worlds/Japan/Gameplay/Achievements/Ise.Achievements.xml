<?xml version="1.0" encoding="utf-8"?>
<Achievements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Ambient.Domain ..\..\..\..\..\Content\Schemas\Gameplay\Gameplay.xsd" xmlns="Ambient.Domain">
  <Achievement RefName="ACH_COMPLETE_ISE" DisplayName="Hero of Ise" Description="Complete the main storyline and become a legend of Ise.">
    <Criteria Type="SagaArcsCompleted" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_DEFEAT_ALL_BOSSES_ISE" DisplayName="Slayer" Description="Bring low every mighty enemy that terrorizes the lands of Ise.">
    <Criteria Type="CharactersDefeatedByType" CharacterType="Boss" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_EXPLORER_ISE" DisplayName="Wanderer" Description="Let your curiosity guide you to every hidden place in Ise.">
    <Criteria Type="SagaArcsDiscovered" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_SOCIAL_ISE" DisplayName="Social Butterfly" Description="Make acquaintance with every soul dwelling in Ise.">
    <Criteria Type="UniqueCharactersMet" Threshold="16" />
  </Achievement>
  <Achievement RefName="ACH_DIALOGUE_MASTER_ISE" DisplayName="Wordsmith" Description="Master the art of conversation with everyone in Ise.">
    <Criteria Type="DialogueTreesCompleted" Threshold="16" />
  </Achievement>
  <Achievement RefName="ACH_COLLECTOR_ISE" DisplayName="Achiever" Description="Earn recognition for completing every challenge in Ise.">
    <Criteria Type="QuestTokensEarned" Threshold="7" />
  </Achievement>
  <Achievement RefName="ACH_MERCHANT_ISE" DisplayName="Master Trader" Description="Conduct business with every merchant in Ise.">
    <Criteria Type="ItemsTraded" Threshold="5" />
  </Achievement>
  <Achievement RefName="ACH_DIPLOMAT_ISE" DisplayName="Ambassador" Description="Represent the best of humanity in your dealings throughout Ise.">
    <Criteria Type="TraitsAssignedByType" TraitType="Friendly" Threshold="8" />
  </Achievement>
</Achievements>
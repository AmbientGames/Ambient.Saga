<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
	<xs:simpleType name="ModelRef">
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TextureRef">
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ClimateModel">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Earth" />
			<xs:enumeration value="Mars" />
		</xs:restriction>
	</xs:simpleType>
</xs:schema>

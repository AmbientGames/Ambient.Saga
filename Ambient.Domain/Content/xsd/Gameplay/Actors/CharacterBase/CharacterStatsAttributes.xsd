<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <!--
    StatBlock: Core attributes used by characters, equipment, spells, consumables.

    Resources (depletable):
      Health   - Death at 0
      Stamina  - Action economy
      Mana     - Abilities/magic

    State:
      Temperature - Body temp, affected by environment + buffs (37°C = normal for a character)

    Attributes (base + modifiers):
      Strength  - Physical damage + carry capacity
      Defense   - Physical damage reduction
      Magic     - Magical damage/effects
      Speed     - Turn order + movement
      Endurance - Stamina efficiency + temperature tolerance
	  
	  NOTE: this was proposed by AI. It should match above
┌─────────────┬──────────────┬────────────────────────────────────────┐
│    Stat     │     Type     │                 Role                   │
├─────────────┼──────────────┼────────────────────────────────────────┤
│ Health      │ Resource     │ Death at 0                             │
│ Stamina     │ Resource     │ Action economy                         │
│ Mana        │ Resource     │ Abilities                              │
│ Body Temp   │ State        │ Condition triggers                     │
├─────────────┼──────────────┼────────────────────────────────────────┤
│ Strength    │ Attribute    │ Physical damage + carry                │
│ Defense     │ Attribute    │ Physical damage reduction              │
│ Magic       │ Attribute    │ Magical damage / effects               │
│ Speed       │ Attribute    │ Turn order + movement                  │
│ Endurance   │ Attribute    │ Stamina efficiency + temp tolerance    │
└─────────────┴──────────────┴────────────────────────────────────────┘

    -->
    <xs:attributeGroup name="StatBlock">
        <!-- Resources -->
        <xs:attribute name="Health" type="xs:float" use="optional" default="1.0"></xs:attribute>
        <xs:attribute name="Stamina" type="xs:float" use="optional" default="1.0"></xs:attribute>
        <xs:attribute name="Mana" type="xs:float" use="optional" default="1.0"></xs:attribute>
        <!-- State -->
        <xs:attribute name="Temperature" type="xs:float" use="optional" default="0.0"></xs:attribute>
        <!-- Attributes -->
        <xs:attribute name="Strength" type="xs:float" use="optional" default="0.0"></xs:attribute>
        <xs:attribute name="Defense" type="xs:float" use="optional" default="0.0"></xs:attribute>
        <xs:attribute name="Magic" type="xs:float" use="optional" default="0.0"></xs:attribute>
        <xs:attribute name="Speed" type="xs:float" use="optional" default="0.0"></xs:attribute>
        <xs:attribute name="Endurance" type="xs:float" use="optional" default="0.0"></xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="ProgressBlock">
        <xs:attribute name="Level" type="xs:int" use="optional" default="1"></xs:attribute>
        <xs:attribute name="Credits" type="xs:float" use="optional" default="0"></xs:attribute>
        <xs:attribute name="Experience" type="xs:float" use="optional" default="0"></xs:attribute>
    </xs:attributeGroup>
</xs:schema>
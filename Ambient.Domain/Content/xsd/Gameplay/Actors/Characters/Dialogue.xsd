<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="../../../EntityBase.xsd" />
    <xs:include schemaLocation="../../Acquirables/QuestToken.xsd" />
    <xs:include schemaLocation="../../Acquirables/Equipment.xsd" />
    <xs:include schemaLocation="../../Acquirables/Tool.xsd" />
    <xs:include schemaLocation="../../Acquirables/Consumable.xsd" />
    <xs:include schemaLocation="../../Acquirables/BuildingMaterial.xsd" />
    <xs:include schemaLocation="../../Acquirables/Spell.xsd" />
    <xs:include schemaLocation="../../Achievements/Achievement.xsd" />
    <xs:include schemaLocation="../../Quests/Quest.xsd" />
    <xs:include schemaLocation="../../CommonTypes.xsd" />
    <xs:simpleType name="DialogueTreeRef">
        <xs:annotation>
            <xs:documentation>Reference key that uniquely identifies a dialogue tree by name.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:minLength value="1" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DialogueNodeId">
        <xs:annotation>
            <xs:documentation>Unique identifier for a node within a dialogue tree.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:minLength value="1" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DialogueConditionType">
        <xs:annotation>
            <xs:documentation>Types of conditions that gate dialogue node visibility or choice availability.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="HasQuestToken">
                <xs:annotation>
                    <xs:documentation>Avatar possesses the specified quest token.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksQuestToken">
                <xs:annotation>
                    <xs:documentation>Avatar does not possess the specified quest token.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasConsumable">
                <xs:annotation>
                    <xs:documentation>Avatar has the specified consumable item in inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksConsumable">
                <xs:annotation>
                    <xs:documentation>Avatar does not have the specified consumable item.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasMaterial">
                <xs:annotation>
                    <xs:documentation>Avatar has the specified building material in inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksMaterial">
                <xs:annotation>
                    <xs:documentation>Avatar does not have the specified building material.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasEquipment">
                <xs:annotation>
                    <xs:documentation>Avatar has the specified equipment item in inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksEquipment">
                <xs:annotation>
                    <xs:documentation>Avatar does not have the specified equipment item.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasTool">
                <xs:annotation>
                    <xs:documentation>Avatar has the specified tool in inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksTool">
                <xs:annotation>
                    <xs:documentation>Avatar does not have the specified tool.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasSpell">
                <xs:annotation>
                    <xs:documentation>Avatar has learned the specified spell.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksSpell">
                <xs:annotation>
                    <xs:documentation>Avatar has not learned the specified spell.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasBlock">
                <xs:annotation>
                    <xs:documentation>Avatar has the specified block type in inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LacksBlock">
                <xs:annotation>
                    <xs:documentation>Avatar does not have the specified block type.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HasAchievement">
                <xs:annotation>
                    <xs:documentation>Avatar has unlocked the specified achievement.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="QuestActive">
                <xs:annotation>
                    <xs:documentation>The specified quest is currently in progress.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="QuestCompleted">
                <xs:annotation>
                    <xs:documentation>The specified quest has been completed.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="QuestNotStarted">
                <xs:annotation>
                    <xs:documentation>The specified quest has not been accepted yet.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Credits">
                <xs:annotation>
                    <xs:documentation>Avatar's credit balance meets the comparison threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Health">
                <xs:annotation>
                    <xs:documentation>Avatar's current health meets the comparison threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="AvatarVisitCount">
                <xs:annotation>
                    <xs:documentation>Number of times the avatar has visited this NPC meets the threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="NodeVisited">
                <xs:annotation>
                    <xs:documentation>A specific dialogue node has been previously visited.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="BossDefeatedCount">
                <xs:annotation>
                    <xs:documentation>Number of bosses the avatar has defeated meets the threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="ReputationLevel">
                <xs:annotation>
                    <xs:documentation>Avatar's reputation level with a faction meets the threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="ReputationValue">
                <xs:annotation>
                    <xs:documentation>Avatar's raw reputation points with a faction meets the threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TraitComparison">
                <xs:annotation>
                    <xs:documentation>A character trait value meets the comparison threshold.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <!-- Party Conditions -->
            <xs:enumeration value="PartySlotAvailable">
                <xs:annotation>
                    <xs:documentation>Check if the avatar has an available party slot</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="IsInParty">
                <xs:annotation>
                    <xs:documentation>Check if a specific character is in the party (uses CharacterRef or current NPC)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="PartySize">
                <xs:annotation>
                    <xs:documentation>Check current party size (uses Operator and Value)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="ComparisonOperator">
        <xs:annotation>
            <xs:documentation>Comparison operators used to evaluate numeric conditions in dialogue.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Equals">
                <xs:annotation>
                    <xs:documentation>Value must exactly equal the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="NotEquals">
                <xs:annotation>
                    <xs:documentation>Value must not equal the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GreaterThan">
                <xs:annotation>
                    <xs:documentation>Value must be strictly greater than the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GreaterThanOrEqual">
                <xs:annotation>
                    <xs:documentation>Value must be greater than or equal to the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LessThan">
                <xs:annotation>
                    <xs:documentation>Value must be strictly less than the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LessThanOrEqual">
                <xs:annotation>
                    <xs:documentation>Value must be less than or equal to the target.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="ConditionLogic">
        <xs:annotation>
            <xs:documentation>Logical operator for combining multiple conditions on a dialogue node.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="AND">
                <xs:annotation>
                    <xs:documentation>All conditions must be true for the node to be available.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="OR">
                <xs:annotation>
                    <xs:documentation>At least one condition must be true for the node to be available.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DialogueActionType">
        <xs:annotation>
            <xs:documentation>Side effects that execute when a dialogue node is visited or a choice is selected.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="GiveQuestToken">
                <xs:annotation>
                    <xs:documentation>Add a quest token to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeQuestToken">
                <xs:annotation>
                    <xs:documentation>Remove a quest token from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveConsumable">
                <xs:annotation>
                    <xs:documentation>Add a consumable item to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeConsumable">
                <xs:annotation>
                    <xs:documentation>Remove a consumable item from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveMaterial">
                <xs:annotation>
                    <xs:documentation>Add a building material to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeMaterial">
                <xs:annotation>
                    <xs:documentation>Remove a building material from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveBlock">
                <xs:annotation>
                    <xs:documentation>Add a block type to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeBlock">
                <xs:annotation>
                    <xs:documentation>Remove a block type from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveEquipment">
                <xs:annotation>
                    <xs:documentation>Add an equipment item to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeEquipment">
                <xs:annotation>
                    <xs:documentation>Remove an equipment item from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveTool">
                <xs:annotation>
                    <xs:documentation>Add a tool to the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeTool">
                <xs:annotation>
                    <xs:documentation>Remove a tool from the avatar's inventory.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="GiveSpell">
                <xs:annotation>
                    <xs:documentation>Teach the avatar a spell.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TakeSpell">
                <xs:annotation>
                    <xs:documentation>Remove a learned spell from the avatar.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TransferCurrency">
                <xs:annotation>
                    <xs:documentation>Transfer credits to or from the avatar (positive Amount gives, negative takes).</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="UnlockAchievement">
                <xs:annotation>
                    <xs:documentation>Unlock an achievement for the avatar.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="AcceptQuest">
                <xs:annotation>
                    <xs:documentation>Avatar accepts the specified quest, making it active.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="CompleteQuest">
                <xs:annotation>
                    <xs:documentation>Force-complete the specified quest and award its rewards.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="AbandonQuest">
                <xs:annotation>
                    <xs:documentation>Abandon the specified active quest.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="OpenMerchantTrade">
                <xs:annotation>
                    <xs:documentation>Open the merchant trade UI with this NPC.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StartBossBattle">
                <xs:annotation>
                    <xs:documentation>Initiate a boss battle encounter with this NPC.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StartCombat">
                <xs:annotation>
                    <xs:documentation>Initiate regular combat with this NPC.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SpawnCharacters">
                <xs:annotation>
                    <xs:documentation>Spawn one or more characters into the world at their designated locations.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="AssignTrait">
                <xs:annotation>
                    <xs:documentation>Assign a trait with a value to the target character.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RemoveTrait">
                <xs:annotation>
                    <xs:documentation>Remove a trait from the target character.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SetCharacterState">
                <xs:annotation>
                    <xs:documentation>Change the NPC's behavioral state (e.g., Neutral, Hostile, Friendly).</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="ChangeReputation">
                <xs:annotation>
                    <xs:documentation>Modify the avatar's reputation with a faction by the specified amount.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <!-- Mid-Battle Actions -->
            <xs:enumeration value="ChangeStance">
                <xs:annotation>
                    <xs:documentation>Change character's combat stance mid-battle (uses RefName for stance)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="ChangeAffinity">
                <xs:annotation>
                    <xs:documentation>Change character's elemental affinity mid-battle (uses RefName for affinity)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="CastSpell">
                <xs:annotation>
                    <xs:documentation>Character casts a spell mid-battle (uses RefName for spell)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SummonAlly">
                <xs:annotation>
                    <xs:documentation>Summon an ally character to join battle (uses CharacterRef)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="EndBattle">
                <xs:annotation>
                    <xs:documentation>End the battle immediately with specified result</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="HealSelf">
                <xs:annotation>
                    <xs:documentation>Character heals themselves (uses Amount for heal percentage)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="ApplyStatusEffect">
                <xs:annotation>
                    <xs:documentation>Apply status effect to target (uses RefName for status effect)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <!-- Party Actions -->
            <xs:enumeration value="JoinParty">
                <xs:annotation>
                    <xs:documentation>NPC joins the avatar's party (uses CharacterRef, requires available slot)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="LeaveParty">
                <xs:annotation>
                    <xs:documentation>NPC leaves the avatar's party (uses CharacterRef)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <!-- Affinity Actions -->
            <xs:enumeration value="GrantAffinity">
                <xs:annotation>
                    <xs:documentation>Grant a character affinity to the avatar (uses RefName for affinity, CharacterRef for source character)</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CharacterStateType">
        <xs:annotation>
            <xs:documentation>Behavioral state of an NPC, controlling how they interact with the avatar.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Neutral">
                <xs:annotation>
                    <xs:documentation>NPC is passive and will not initiate interaction or combat.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Friendly">
                <xs:annotation>
                    <xs:documentation>NPC is friendly and available for dialogue or trade.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Hostile">
                <xs:annotation>
                    <xs:documentation>NPC is aggressive and will initiate combat on sight.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="InBattle">
                <xs:annotation>
                    <xs:documentation>NPC is currently engaged in combat.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Fleeing">
                <xs:annotation>
                    <xs:documentation>NPC is fleeing from combat.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Defeated">
                <xs:annotation>
                    <xs:documentation>NPC has been defeated in combat and is no longer active.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
	<xs:simpleType name="CharacterTraitType">
		<xs:annotation>
			<xs:documentation>Named traits that can be assigned to characters to control behavior, combat, and trade.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Hostile">
				<xs:annotation>
					<xs:documentation>Character is hostile toward the avatar (boolean trait).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Friendly">
				<xs:annotation>
					<xs:documentation>Character is friendly toward the avatar (boolean trait).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WillTrade">
				<xs:annotation>
					<xs:documentation>Character is willing to trade with the avatar (boolean trait).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BossFight">
				<xs:annotation>
					<xs:documentation>Character is a boss encounter (boolean trait).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Aggression">
				<xs:annotation>
					<xs:documentation>How aggressively the character fights (0-100, higher = more aggressive).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Morale">
				<xs:annotation>
					<xs:documentation>Character's willingness to keep fighting (0-100, drops as battle goes badly).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FleeThreshold">
				<xs:annotation>
					<xs:documentation>Health percentage at which the character will attempt to flee combat.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GrantsAffinity">
				<xs:annotation>
					<xs:documentation>Defeating or befriending this character grants the avatar an elemental affinity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DefenseBonus">
				<xs:annotation>
					<xs:documentation>Flat bonus added to the character's defense stat.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TradeDiscount">
				<xs:annotation>
					<xs:documentation>Percentage discount this merchant applies to trade prices.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!-- Bargaining/Trade Traits -->
			<xs:enumeration value="WillingToBargain">
				<xs:annotation>
					<xs:documentation>Merchant's openness to negotiation (0-100, higher = easier to bargain with)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BargainSkill">
				<xs:annotation>
					<xs:documentation>Avatar's bargaining ability (0-100, higher = better discounts)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NegotiatedDiscount">
				<xs:annotation>
					<xs:documentation>Final negotiated discount percentage after bargaining</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!-- Battle Behavior Traits -->
			<xs:enumeration value="BerserkThreshold">
				<xs:annotation>
					<xs:documentation>Health % that triggers berserk mode (switch to Offensive stance)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TacticalRetreat">
				<xs:annotation>
					<xs:documentation>Health % that triggers defensive tactics (switch to Defensive stance)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LastStand">
				<xs:annotation>
					<xs:documentation>Health % that triggers desperate all-out attack</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Merciful">
				<xs:annotation>
					<xs:documentation>Avatar shows mercy in battle (spares defeated enemies)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Ruthless">
				<xs:annotation>
					<xs:documentation>Avatar is ruthless in battle (finishes defeated enemies)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!-- Combat state traits -->
			<xs:enumeration value="Disengaged">
				<xs:annotation>
					<xs:documentation>Avatar fled from combat with this character - prevents immediate re-aggro</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Victorious">
				<xs:annotation>
					<xs:documentation>This character won the battle (avatar fled or was defeated)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Spared">
				<xs:annotation>
					<xs:documentation>Avatar defeated but spared this character</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="DialogueCondition">
        <xs:annotation>
            <xs:documentation>A prerequisite that must be met for a dialogue node or choice to be available.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="Type" type="DialogueConditionType" use="required">
            <xs:annotation>
                <xs:documentation>The kind of check to perform (inventory, quest state, numeric comparison, etc.).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="RefName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Reference name of the item, quest, achievement, or node being checked.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Operator" type="ComparisonOperator" use="optional" default="Equals">
            <xs:annotation>
                <xs:documentation>Comparison operator for numeric conditions (Credits, Health, etc.).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Value" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Target value for comparison-based conditions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="FactionRef" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Reference name of the faction for reputation-based conditions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Trait" type="CharacterTraitType" use="optional">
            <xs:annotation>
                <xs:documentation>The trait to evaluate for TraitComparison conditions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="DialogueChoice">
        <xs:annotation>
            <xs:documentation>A player-selectable response option within a dialogue node.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="Text" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>Display text shown to the player for this choice.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="NextNodeId" type="DialogueNodeId" use="required">
            <xs:annotation>
                <xs:documentation>The dialogue node to navigate to when this choice is selected.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Cost" type="xs:int" use="optional">
            <xs:annotation>
                <xs:documentation>Credit cost the avatar must pay to select this choice.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="DialogueAction">
        <xs:annotation>
            <xs:documentation>A side effect that executes when a dialogue node is visited or a choice is selected.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="Type" type="DialogueActionType" use="required">
            <xs:annotation>
                <xs:documentation>The kind of action to perform (give/take items, start quest, initiate combat, etc.).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="RefName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Reference name of the item, quest, spell, or other entity this action targets.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="CharacterRef" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Reference name of the target character for party, combat, or spawn actions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Amount" type="xs:int" use="optional" default="1">
            <xs:annotation>
                <xs:documentation>Quantity for item transfers, currency amounts, or heal percentages.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Trait" type="CharacterTraitType" use="optional">
            <xs:annotation>
                <xs:documentation>The trait to assign or remove for AssignTrait/RemoveTrait actions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="TraitValue" type="xs:int" use="optional">
            <xs:annotation>
                <xs:documentation>Numeric value to set for the trait when using AssignTrait.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="FactionRef" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>Reference name of the faction for ChangeReputation actions.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="DialogueNode">
        <xs:annotation>
            <xs:documentation>A single step in a dialogue tree containing NPC text, conditions, actions, and player choices.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Condition" type="DialogueCondition" minOccurs="0" maxOccurs="unbounded"></xs:element>
            <xs:element name="Text" type="xs:string" minOccurs="0" maxOccurs="unbounded"></xs:element>
            <xs:element name="Action" type="DialogueAction" minOccurs="0" maxOccurs="unbounded"></xs:element>
            <xs:element name="Choice" type="DialogueChoice" minOccurs="0" maxOccurs="unbounded"></xs:element>
        </xs:sequence>
        <xs:attribute name="NodeId" type="DialogueNodeId" use="required">
            <xs:annotation>
                <xs:documentation>Unique identifier for this node within its dialogue tree.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="NextNodeId" type="DialogueNodeId" use="optional">
            <xs:annotation>
                <xs:documentation>Node to auto-advance to if no choices are present (linear dialogue flow).</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="ConditionLogic" type="ConditionLogic" use="optional" default="AND">
            <xs:annotation>
                <xs:documentation>How multiple conditions are combined: AND requires all, OR requires at least one.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="DialogueTree">
        <xs:annotation>
            <xs:documentation>A complete conversation tree containing interconnected dialogue nodes.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="EntityBase">
                <xs:sequence>
                    <xs:element name="Node" type="DialogueNode" minOccurs="1" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="StartNodeId" type="DialogueNodeId" use="required">
                    <xs:annotation>
                        <xs:documentation>The node where the conversation begins when the avatar initiates dialogue.</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="DialogueTrees">
        <xs:annotation>
            <xs:documentation>Container for all dialogue trees defined in a world.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="DialogueTree" type="DialogueTree" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>
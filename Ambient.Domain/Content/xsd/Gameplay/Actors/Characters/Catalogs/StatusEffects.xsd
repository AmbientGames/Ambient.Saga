<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="../../../../EntityBase.xsd" />

    <xs:simpleType name="StatusEffectRef">
        <xs:annotation><xs:documentation>Reference to a StatusEffect by RefName. Used on equipment, spells, and consumables to link to effects they can apply or cleanse.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z0-9_]+" />
            <xs:minLength value="1" />
            <xs:maxLength value="64" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="StatusEffectType">
        <xs:annotation><xs:documentation>Classification of status effects. Determines the core mechanic of the effect in battle.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="DamageOverTime" />  <!-- Poison, Bleed, Burn -->
            <xs:enumeration value="Stun" />            <!-- Cannot act -->
            <xs:enumeration value="Slow" />            <!-- Reduced speed -->
            <xs:enumeration value="Weaken" />          <!-- Reduced damage output -->
            <xs:enumeration value="Vulnerable" />      <!-- Increased damage taken -->
            <xs:enumeration value="Blind" />           <!-- Reduced accuracy -->
            <xs:enumeration value="Silence" />         <!-- Cannot cast spells -->
            <xs:enumeration value="Root" />            <!-- Cannot flee -->
            <xs:enumeration value="StatBoost" />       <!-- Temporary stat increase -->
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ApplicationMethod">
        <xs:annotation><xs:documentation>When a status effect applies its periodic effects during a battle turn.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="StartOfTurn" />     <!-- Applied at turn start -->
            <xs:enumeration value="EndOfTurn" />       <!-- Applied at turn end -->
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="StatusEffect">
        <xs:annotation>
            <xs:documentation>A status effect that can be applied to characters during combat. Effects can deal damage over time, modify stats, or restrict actions. Equipment, spells, and consumables can apply or cleanse status effects.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="EntityBase">
                <xs:attribute name="Type" type="StatusEffectType" use="required">
                    <xs:annotation><xs:documentation>The core mechanic of this effect (DamageOverTime, Stun, StatBoost, etc.).</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="DamagePerTurn" type="xs:int" use="optional" default="0">
                    <xs:annotation><xs:documentation>Health damage (or healing if negative) applied each turn. Primarily used with DamageOverTime effects.</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="DurationTurns" type="xs:int" use="optional" default="3">
                    <xs:annotation><xs:documentation>Number of battle turns the effect lasts. 0 = permanent until cleansed.</xs:documentation></xs:annotation>
                </xs:attribute>

                <!-- Stat modifiers applied while the effect is active -->
                <xs:attribute name="StrengthModifier" type="xs:float" use="optional" default="0.0">
                    <xs:annotation><xs:documentation>Modifier to Strength while active. Positive = buff, negative = debuff.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="DefenseModifier" type="xs:float" use="optional" default="0.0">
                    <xs:annotation><xs:documentation>Modifier to Defense while active. Positive = buff, negative = debuff.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="SpeedModifier" type="xs:float" use="optional" default="0.0">
                    <xs:annotation><xs:documentation>Modifier to Speed while active. Positive = buff, negative = debuff.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="MagicModifier" type="xs:float" use="optional" default="0.0">
                    <xs:annotation><xs:documentation>Modifier to Magic while active. Positive = buff, negative = debuff.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="AccuracyModifier" type="xs:float" use="optional" default="0.0">
                    <xs:annotation><xs:documentation>Modifier to accuracy while active. Positive = buff, negative = debuff.</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="MaxStacks" type="xs:int" use="optional" default="1">
                    <xs:annotation><xs:documentation>Maximum number of simultaneous instances of this effect on one character. 0 = no stacking (only one instance allowed).</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="Cleansable" type="xs:boolean" use="optional" default="true">
                    <xs:annotation><xs:documentation>Whether this effect can be removed by consumables or spells with the Cleanse attribute.</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="ApplicationMethod" type="ApplicationMethod" use="optional" default="StartOfTurn">
                    <xs:annotation><xs:documentation>When periodic effects (like DamagePerTurn) are applied during a battle turn.</xs:documentation></xs:annotation>
                </xs:attribute>

                <xs:attribute name="Category" use="optional">
                    <xs:annotation><xs:documentation>Visual category for UI display. Buff = positive effect, Debuff = negative effect.</xs:documentation></xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Debuff" />
                            <xs:enumeration value="Buff" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="StatusEffects">
        <xs:annotation><xs:documentation>Catalog of all status effects available in the world. Defined in StatusEffects.xml.</xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:element name="StatusEffect" type="StatusEffect" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>

<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="../Actors/CharacterBase/CharacterStatsAttributes.xsd" />
    <xs:complexType name="Attributes">
        <xs:annotation>
            <xs:documentation>
                StatBlock wrapper for use on equipment, spells, consumables, and stances.
                Positive values buff the stat; negative values debuff it.
            </xs:documentation>
        </xs:annotation>
        <xs:attributeGroup ref="StatBlock" />
    </xs:complexType>
</xs:schema>
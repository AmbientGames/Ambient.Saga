<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="../Actors/CharacterBase/CharacterStatsAttributes.xsd" />
    <xs:complexType name="RewardEffects">
        <xs:annotation>
            <xs:documentation>
                Wraps StatBlock + ProgressBlock for quest rewards and combat rewards.
                Grants stat changes and progression (experience, credits, level) on completion.
            </xs:documentation>
        </xs:annotation>
        <xs:attributeGroup ref="StatBlock" />
        <xs:attributeGroup ref="ProgressBlock" />
    </xs:complexType>
</xs:schema>
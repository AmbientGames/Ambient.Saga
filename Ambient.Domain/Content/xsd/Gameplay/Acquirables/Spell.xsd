<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="DegradableAcquirable.xsd" />
    <xs:include schemaLocation="../Usability.xsd" />
    <xs:include schemaLocation="Attributes.xsd" />
    <xs:simpleType name="SpellRef">
        <xs:restriction base="xs:string">
            <xs:minLength value="1" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SpellCategoryType">
        <xs:annotation>
            <xs:documentation>Spell category for archetype loadout matching and UI grouping.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <!-- Combat roles -->
            <xs:enumeration value="Damage" />
            <xs:enumeration value="Healing" />
            <xs:enumeration value="Buff" />
            <xs:enumeration value="Debuff" />
            <xs:enumeration value="Control" />
            <xs:enumeration value="Summoning" />
            <xs:enumeration value="Conjuration" />
            <!-- Thematic -->
            <xs:enumeration value="Elemental" />
            <xs:enumeration value="Destruction" />
            <xs:enumeration value="Holy" />
            <xs:enumeration value="Unholy" />
            <xs:enumeration value="Nature" />
            <xs:enumeration value="Arcane" />
            <xs:enumeration value="Protection" />
            <!-- Utility -->
            <xs:enumeration value="Utility" />
            <xs:enumeration value="Movement" />
            <xs:enumeration value="Stealth" />
            <xs:enumeration value="Tracking" />
            <xs:enumeration value="Poison" />
            <!-- Archetype-specific -->
            <xs:enumeration value="Combat" />
            <xs:enumeration value="Rage" />
            <xs:enumeration value="Charm" />
            <xs:enumeration value="Illusion" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Spell">
        <xs:annotation>
            <xs:documentation>Castable ability with stat effects, optional status effects, and optional cleanse.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="DegradableAcquirable">
                <xs:sequence>
                    <xs:element name="Effects" type="Attributes" minOccurs="1" maxOccurs="1">
                        <xs:annotation><xs:documentation>Stat modifiers applied when this spell is cast.</xs:documentation></xs:annotation>
                    </xs:element>
                    <xs:element name="MinimumStats" type="Attributes" minOccurs="0">
                        <xs:annotation><xs:documentation>Minimum stat values required to cast this spell.</xs:documentation></xs:annotation>
                    </xs:element>
                </xs:sequence>
                <xs:attributeGroup ref="UseAttributes" />
                <xs:attribute name="Category" type="SpellCategoryType" use="required">
                    <xs:annotation><xs:documentation>Spell category for archetype loadout matching.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="RequiresEquipped" type="EquipmentCategoryType" use="optional">
                    <xs:annotation><xs:documentation>Equipment category that must be equipped to cast (e.g. Staff, Wand, Focus).</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="StatusEffectRef" type="xs:string" use="optional">
                    <xs:annotation><xs:documentation>Status effect applied on cast. References a StatusEffect RefName.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="StatusEffectChance" type="xs:float" use="optional" default="1.0">
                    <xs:annotation><xs:documentation>Probability (0.0-1.0) of applying the status effect on cast.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="CleansesStatusEffects" type="xs:boolean" use="optional" default="false">
                    <xs:annotation><xs:documentation>When true, removes all active status effects from the target.</xs:documentation></xs:annotation>
                </xs:attribute>
                <xs:attribute name="CleanseTargetSelf" type="xs:boolean" use="optional" default="true">
                    <xs:annotation><xs:documentation>When true, cleanse targets the caster. When false, targets the opponent.</xs:documentation></xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="SpellCatalog">
        <xs:sequence>
            <xs:element name="Spell" type="Spell" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>
<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Ambient.Domain" xmlns="Ambient.Domain" elementFormDefault="qualified">
    <xs:include schemaLocation="../../../SharedRefs.xsd" />
    <xs:complexType name="BlockEntry">
        <xs:annotation>
            <xs:documentation>A single block type in inventory, tracked by quantity (float for partial blocks from mining).</xs:documentation>
        </xs:annotation>
        <xs:attribute name="BlockRef" type="BlockRef" use="required">
            <xs:annotation>
                <xs:documentation>The stack's full identity. Variation is folded into this ref (base ref for variation 0, "baseRef#n" for variations 1-7), mirroring how the voxel layer packs variation into the block word. Refs differing only in variation are distinct stacks; nothing above the voxel seam parses the format.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Quantity" type="xs:float" use="required" />
    </xs:complexType>
    <xs:complexType name="BlockInventory">
        <xs:annotation>
            <xs:documentation>Collection of mined/harvested block items.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Entry" type="BlockEntry" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>
</xs:schema>